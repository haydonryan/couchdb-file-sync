# CouchDB File Sync Configuration Example
# Copy this file to couchdb-file-sync.yaml and customize for your setup

# CouchDB connection settings
couchdb:
  url: "http://localhost:5984"
  # Authentication (optional, only needed if CouchDB requires login)
  auth:
    username: "admin"
    password: "${COUCHDB_PASSWORD}"  # Can use environment variable substitution
  database: "couchdb_file_sync_files"
  # Remote path prefix to sync (e.g., "notes/" or "obsidian/")
  # Empty or "/" means sync the entire database
  remote_path: ""
  timeout_seconds: 30
  retry_attempts: 3

# Sync behavior settings
sync:
  # Root directory to sync (default: current directory)
  # root_dir: "/home/user/documents"
  
  # Daemon mode: poll interval in seconds
  poll_interval: 60
  
  # File watching: debounce time in milliseconds
  debounce_ms: 500
  
  # Batch size for bulk operations
  batch_size: 100
  
  # Maximum file size to sync (in bytes, 0 = unlimited)
  max_file_size: 1073741824  # 1GB
  
  # Enable parallel uploads/downloads
  parallel: true
  max_parallel: 4

  # How long (seconds) a soft-delete tombstone is kept before it is pruned so
  # get_all_files/get_changes do not grow unbounded. 0 disables pruning.
  # Default: 604800 (7 days)
  tombstone_retention_secs: 604800

# Ignore patterns (alternative to .sync-ignore file)
ignore:
  patterns:
    - "*.log"
    - "*.tmp"
    - "*.swp"
    - ".DS_Store"
  
  # Additional ignore files to read
  ignore_files:
    - ".sync-ignore"
    - ".gitignore"

# Conflict resolution settings
conflicts:
  default_strategy: keep-both  # keep-both, keep-local, keep-remote, skip
  auto_resolve: false
  conflict_dir: ".conflicts"  # Where to store conflict copies

# Notification settings (Telegram and/or Matrix)
notifications:
  telegram:
    # Include only if you have Telegram notification credentials
    # credentials:
    #   bot_token: "${TELEGRAM_BOT_TOKEN}"  # From @BotFather
    #   chat_id: "${TELEGRAM_CHAT_ID}"      # Your chat ID
  matrix:
    # Include only if you have Matrix notification credentials
    # credentials:
    #   homeserver_url: "${MATRIX_HOMESERVER_URL}"  # e.g. https://matrix.example.com
    #   access_token: "${MATRIX_ACCESS_TOKEN}"      # Matrix access token
    #   room_id: "${MATRIX_ROOM_ID}"                # Room ID to send notifications to
    message_type: m.notice  # m.notice, m.text, or m.emote
  notify_on_conflict: true
  notify_on_sync_error: true

# Logging settings
logging:
  level: info      # trace, debug, info, warn, error
  format: pretty   # pretty, json, compact
  # file: "~/.local/state/couchdb-file-sync/couchdb-file-sync.log"  # Optional file output (used by sync/daemon)
  rotation: daily-delete  # never, daily-keep, daily-delete
